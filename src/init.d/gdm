#!/sbin/openrc-run

supervisor=supervise-daemon
command="/usr/bin/gdm"

depend() {
    need localmount

    after bootmisc consolefont modules netmount
    after readahead-list ypbind autofs openvpn gpm lircmd
    after quota keymaps
    before alsasound
    want elogind
    use xfs

    provide xdm display-manager
}